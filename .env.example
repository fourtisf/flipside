# ---------- Core ----------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
DATABASE_URL=postgresql://coinside:coinside@localhost:5432/coinside
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me
COOKIE_SECRET=change-me
API_PORT=4000
ENGINE_HEALTH_PORT=4101
INDEXER_HEALTH_PORT=4102
WORKER_HEALTH_PORT=4103
LOG_LEVEL=info

# ---------- Solana ----------
SOLANA_CLUSTER=devnet                      # devnet | mainnet-beta
HELIUS_API_KEY=
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=
HELIUS_LASERSTREAM_URL=                    # or a Yellowstone gRPC endpoint
VAULT_PROGRAM_ID=
ENGINE_SIGNER_KEYPAIR_PATH=/etc/coinside/keys/engine-signer.json   # server only, never commit
ROOT_POSTER_KEYPAIR_PATH=/etc/coinside/keys/root-poster.json      # server only, never commit
SQUADS_MULTISIG=                           # admin and upgrade authority

# ---------- Data sources ----------
JUPITER_PRICE_API=                         # current Jupiter Price API endpoint, check their docs
PYTH_SOL_USD_FEED_ID=                      # Pyth SOL/USD price feed id
BIRDEYE_API_KEY=                           # optional, for discovery and metadata

# ---------- Alerts ----------
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# ---------- Trading rules (defaults from CLAUDE.md) ----------
OPEN_FEE_BPS=100
CLOSE_FEE_BPS=100
POOL_FEE_SHARE_BPS=8000
REFERRAL_SHARE_OF_PROTOCOL_BPS=5000
COMPETITION_SHARE_OF_PROTOCOL_BPS=5000
MIN_TRADE_LAMPORTS=10000000                # 0.01 SOL
MIN_HOLD_SECONDS=10
TWAP_SECONDS=60
LEV_TIERS=2:0,5:150,10:500                 # leverage:min SOL liquidity
MAX_WIN_TIERS=20000:0,40000:100,60000:250,100000:500   # bps:min pool SOL
SIDE_CAP_LIQ_BPS=100                       # 1% of coin liquidity per side
SIDE_CAP_MAX_SOL=30
POOL_COIN_EXPOSURE_BPS=200                 # 2% of pool NAV per coin
POSITION_MAX_POOL_BPS=500                  # 5% of pool NAV per position

# ---------- Risk engine ----------
MIN_MCAP_USD=30000
MIN_HOLDERS=100
MIN_FEES_PAID_SOL=7
MIN_TRADING_HOURS=24
MIN_WALLET_AGE_HOURS=24
RUG_GUARD_LIQ_DROP_BPS=3000                # 30%
RUG_GUARD_WINDOW_SECONDS=300
INSIDER_TOP_HOLDERS=20
INSIDER_FUNDING_HOPS=2
INSIDER_FUNDING_WINDOW_DAYS=7               # funded within 7 days before launch
SKEW_RATIO=2
SKEW_FEE_BPS_PER_HOUR=10
HOURLY_LOSS_BREAKER_BPS=300                # 3% of pool NAV
HOURLY_LOSS_PAUSE_MINUTES=15
COIN_LOSS_BREAKER_BPS=100                  # 1% of pool NAV on one coin
COIN_LOSS_PAUSE_MINUTES=60
DEVIATION_GUARD_BPS=500                    # 5% vs Jupiter for 30s
DEVIATION_GUARD_SECONDS=30
PRICE_MIN_POOL_LIQ_SOL=25                  # pools below this are left out of the median price

# ---------- Proofs and practice ----------
BALANCE_ROOT_INTERVAL_SECONDS=300
EMERGENCY_STALE_HOURS=72
PRACTICE_GRANT_SOL=10
SESSION_KEY_HOURS=24

# ---------- Launch caps (P6) ----------
LAUNCH_POOL_MAX_SOL=250
LAUNCH_POSITION_MAX_SOL=1
