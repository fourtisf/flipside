# Installed to /etc/systemd/system/pm2-coinside.service by deploy/bootstrap.sh. Starts the coinside
# user's PM2 daemon at boot and brings back the processes saved by the last `pm2 save` (coinside-deploy
# saves after every successful deploy). If the daemon dies, systemd starts it again.
[Unit]
Description=PM2 for Coinside (web, api, engine, indexer, worker)
Documentation=https://pm2.keymetrics.io/
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=coinside
Group=coinside
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=PM2_HOME=/home/coinside/.pm2
PIDFile=/home/coinside/.pm2/pm2.pid
LimitNOFILE=65536
# Through env, so this works wherever PM2 is installed (npm puts it in /usr/bin or /usr/local/bin).
ExecStart=/usr/bin/env pm2 resurrect
ExecStop=/usr/bin/env pm2 kill
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
