{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "APP_URL",
        "NEXT_PUBLIC_COINSIDE_UI",
        "NEXT_PUBLIC_HL_TESTNET",
        "NEXT_PUBLIC_TRADING",
        "NEXT_PUBLIC_MAX_ORDER_USD",
        "NEXT_PUBLIC_MAX_DEPOSIT_SOL",
        "NEXT_PUBLIC_TOKEN_CA",
        "NEXT_PUBLIC_X_URL",
        "NEXT_PUBLIC_TELEGRAM_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
