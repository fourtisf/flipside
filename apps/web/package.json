{
  "name": "@coinside/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "build:prototype": "NEXT_PUBLIC_COINSIDE_UI=prototype NEXT_DIST_DIR=.next-prototype next build",
    "start:prototype": "NEXT_DIST_DIR=.next-prototype next start -p 3000"
  },
  "dependencies": {
    "@coinside/core": "workspace:*",
    "@nktkas/hyperliquid": "0.33.3",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "d3-hierarchy": "^3.1.2",
    "geist": "^1.8.2",
    "lightweight-charts": "^5.2.1",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@solana/web3.js": "1.98.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-config-next": "15.5.28",
    "vitest": "^4.1.12"
  }
}
